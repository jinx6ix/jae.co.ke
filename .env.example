# ============================================================
# JaeTravel Platform — merged environment
# One deployment, several subsystems below. Each section notes
# which part of the app actually reads these vars.
# ============================================================

# ─── jaedb operational database (Postgres via Prisma) ──────────────────────
# Bookings, invoices, vouchers, cost sheets, the sr_* hotel/rate tables.
DATABASE_URL=

DIRECT_URL=


# ─── NextAuth (staff login for /login, /dashboard) ─────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=


# ─── NVIDIA NIM (AI agent layer) ───────────────────────────────────────────
NVIDIA_API_KEY=


# ─── SMTP (jaedb agent notifications / vouchers) ───────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_SERVERNAME=

# ─── Payload CMS (its own MongoDB — separate from jaedb's Postgres above) ──
# Fill in a real MongoDB connection string (Atlas or self-hosted) and a
# long random secret. These were NOT in either original .env — Payload
# needs both to run at all.
PAYLOAD_DATABASE_URL=
PAYLOAD_SECRET=

# ─── Website's own Supabase project (legacy — pre-dates the jaedb link) ────
# Still used by: /api/site-inquiries, /api/site-tours, /api/transfers,
# /api/vehicle-hire, /api/pdf, /api/download-pdf, /api/inquiries — none
# of these write to jaedb's database. Worth deciding whether these
# should eventually be retired in favor of the /api/public/quote flow
# (see INTEGRATION.md), but they're left working as-is for now.
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_HOST=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
POSTGRES_PRISMA_URL=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# ─── Website content settings ──────────────────────────────────────────────
FROM_EMAIL=
ADMIN_EMAIL=

GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BASE_URL=

RESEND_API_KEY=


# ─── Website's own SMTP (legacy inquiry/vehicle-hire/transfer emails) ─────
# Renamed from SMTP_* to SITE_SMTP_* — kept distinct from jaedb's own
# SMTP_* section above since these were two separate accounts in the
# original two projects; using the same variable name for both would
# have silently dropped one of them (last one wins in a flat .env file).
SITE_SMTP_HOST=
SITE_SMTP_PORT=
SITE_SMTP_USER=
SITE_SMTP_PASS=

# --- Google Customer Reviews (Store Quality program) ------------------------
# Requires signing up at Google Merchant Center and completing the Program
# Agreement -- this is an account-level step only Jinx can do. Once you have
# a Merchant ID, set it here; leave blank and both components render nothing.
NEXT_PUBLIC_GOOGLE_MERCHANT_ID=

# ─── Cache revalidation (tag-based, see app/api/revalidate/route.ts) ───────
# Shared secret for the /api/revalidate endpoint. The Payload Media
# collection's afterChange hook POSTs to /api/revalidate?tag=media with
# this secret in the x-revalidate-secret header. Generate a long random
# value, e.g. `openssl rand -hex 32`. If unset, the revalidate endpoint
# refuses to run (fail-closed) and the Media hook falls back to the
# cache's natural TTL.
REVALIDATE_SECRET=


# ─── YouTube Data API v3 (video sync + embed metadata) ─────────────────────
# Used by lib/youtube.ts and app/api/video-sync/youtube/route.ts. The API
# key lives server-side only — never NEXT_PUBLIC. Get one at
# https://console.cloud.google.com/apis/credentials. Daily quota is 10,000
# units; each playlistItems.list call costs 1 unit, videos.list costs 1
# unit, so a full channel sync of N videos costs roughly N units.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Public handle + id for the subscribe button + footer icon + sameAs schema.
# NEXT_PUBLIC_YOUTUBE_CHANNEL_URL is the human-readable URL form
# (https://www.youtube.com/@yourhandle) — used by the footer + schema.
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID is the UC… form — used by Google's
# platform.js g-ytsubscribe widget. Either alone works; the widget falls
# back to a red pill button if only the URL is set.
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Cron-shared secret for the /api/video-sync/youtube route. Allows the
# route to be triggered from a Vercel Cron / external scheduler without a
# logged-in admin session. Generate a long random value.
CRON_SECRET=


# ─── Instagram Graph API (Reels sync + embed metadata) ─────────────────────
# Used by lib/instagram.ts and app/api/video-sync/instagram/route.ts.
# Requires a Facebook App with Instagram Basic Display or Graph API
# permissions, an IG Business account, and a long-lived access token.
# The user id is the numeric IG Business account id, NOT the @handle.
#
# DEPRECATED: prefer the OAuth flow via the admin dashboard ("Connect
# Instagram" on the BeforeDashboard panel), which writes encrypted tokens
# to the SocialAccount Prisma table. These env vars are read only as a
# last-resort fallback when no SocialAccount row exists. The admin
# "Mint Instagram token" modal lets you write here directly.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=


# ─── Token encryption key (AES-256-GCM) ────────────────────────────────────
# Used by lib/instagram/crypto.ts to encrypt IG tokens at rest in the
# SocialAccount Prisma table. Must be 32 random bytes, base64-encoded.
# Generate with: `openssl rand -base64 32`
# Rotate: re-encrypt every SocialAccount row with the new key, then
# redeploy. The status endpoint surfaces "Token encrypted with an old key"
# if a row can't be decrypted with the current key.
# Server-only — never NEXT_PUBLIC.
TOKEN_ENCRYPTION_KEY=


# ─── Meta / Facebook SDK (Facebook Login + Graph API app credentials) ─────
# NEXT_PUBLIC_META_APP_ID is shipped to the browser — it has to be. The
# Facebook JS SDK needs it to initialize the FB object. App ids are public
# by design (they appear in the rendered HTML anyway).
#
# META_APP_SECRET MUST stay server-side — exposing it would let anyone
# impersonate the app on the Graph API. Only the API routes that talk to
# Facebook should read it.
#
# META_FACEBOOK_LOGIN_CONFIG_ID is the "Facebook Login for Business"
# configuration id (the new flow that replaces plain Facebook Login). It
# is also public.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_LOGIN_CONFIG_ID=

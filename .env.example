# ============================================================
# JaeTravel Platform — merged environment
# One deployment, several subsystems below. Each section notes
# which part of the app actually reads these vars.
# ============================================================

# ─── jaedb operational database (Postgres via Prisma) ──────────────────────
# Bookings, invoices, vouchers, cost sheets, the sr_* hotel/rate tables.
DATABASE_URL=

DIRECT_URL=


# ─── NextAuth (staff login for /login, /dashboard) ─────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=


# ─── NVIDIA NIM (AI agent layer) ───────────────────────────────────────────
NVIDIA_API_KEY=


# ─── SMTP (jaedb agent notifications / vouchers) ───────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_SERVERNAME=

# ─── Payload CMS (its own MongoDB — separate from jaedb's Postgres above) ──
# Fill in a real MongoDB connection string (Atlas or self-hosted) and a
# long random secret. These were NOT in either original .env — Payload
# needs both to run at all.
PAYLOAD_DATABASE_URL=
PAYLOAD_SECRET=

# ─── Website's own Supabase project (legacy — pre-dates the jaedb link) ────
# Still used by: /api/site-inquiries, /api/site-tours, /api/transfers,
# /api/vehicle-hire, /api/pdf, /api/download-pdf, /api/inquiries — none
# of these write to jaedb's database. Worth deciding whether these
# should eventually be retired in favor of the /api/public/quote flow
# (see INTEGRATION.md), but they're left working as-is for now.
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_HOST=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
POSTGRES_PRISMA_URL=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# ─── Website content settings ──────────────────────────────────────────────
FROM_EMAIL=
ADMIN_EMAIL=

GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BASE_URL=

RESEND_API_KEY=


# ─── Website's own SMTP (legacy inquiry/vehicle-hire/transfer emails) ─────
# Renamed from SMTP_* to SITE_SMTP_* — kept distinct from jaedb's own
# SMTP_* section above since these were two separate accounts in the
# original two projects; using the same variable name for both would
# have silently dropped one of them (last one wins in a flat .env file).
SITE_SMTP_HOST=
SITE_SMTP_PORT=
SITE_SMTP_USER=
SITE_SMTP_PASS=

# --- Google Customer Reviews (Store Quality program) ------------------------
# Requires signing up at Google Merchant Center and completing the Program
# Agreement -- this is an account-level step only Jinx can do. Once you have
# a Merchant ID, set it here; leave blank and both components render nothing.
NEXT_PUBLIC_GOOGLE_MERCHANT_ID=

# ─── Cache revalidation (tag-based, see app/api/revalidate/route.ts) ───────
# Shared secret for the /api/revalidate endpoint. The Payload Media
# collection's afterChange hook POSTs to /api/revalidate?tag=media with
# this secret in the x-revalidate-secret header. Generate a long random
# value, e.g. `openssl rand -hex 32`. If unset, the revalidate endpoint
# refuses to run (fail-closed) and the Media hook falls back to the
# cache's natural TTL.
REVALIDATE_SECRET=
